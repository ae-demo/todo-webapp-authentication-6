{
  "version": 3,
  "permissions": [
    {
      "resource": "todos",
      "component": "todo-api",
      "description": "A user's own to-do items",
      "actions": [
        { "handle": "read", "description": "The caller's own to-do items" },
        { "handle": "submit", "description": "Create a to-do item" },
        { "handle": "manage", "description": "Edit, complete/reopen, or delete the caller's own to-do items" }
      ]
    }
  ],
  "groups": [],
  "roles": [
    {
      "name": "User",
      "description": "Signs in and manages their own to-do items.",
      "stories": [1, 2, 3, 4, 5, 6, 7],
      "grants": ["todos:read", "todos:submit", "todos:manage"],
      "assignTo": ["Users"]
    }
  ],
  "testUsers": [
    { "username": "test-user", "roles": ["User"] },
    { "username": "test-user-2", "roles": ["User"] }
  ]
}
